# ─── Backend API URL ──────────────────────────────────────────────────────────
# Local development: leave as default (uses localhost:8080 fallback in useAppState.jsx)
# Production (Vercel): Set this to your Render backend URL
# Example: VITE_API_BASE_URL=https://carbonchain-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# ─── Groq AI API Key ─────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here
