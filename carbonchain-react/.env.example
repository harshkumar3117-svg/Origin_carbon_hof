# ─── Backend API URL ──────────────────────────────────────────────────────────
# Local development: leave as default (uses localhost:8080 fallback in useAppState.jsx)
# Production (Vercel): Set this to your Render backend URL
VITE_API_BASE_URL=http://localhost:8080/api

# ─── Python ML API URLs ──────────────────────────────────────────────────────
# Individual carbon footprint model (port 5000 locally)
VITE_ML_INDIVIDUAL_URL=http://localhost:5000/predict

# Company carbon footprint model (port 5001 locally)
VITE_ML_COMPANY_URL=http://localhost:5001/predict

# ─── Groq AI API Key ─────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here
